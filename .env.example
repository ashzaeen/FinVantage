# Copy to .env. Everything has a working default, so the stubs run with no .env at all.
# Server-side keys stay here. The web app and extension never hold model or bank keys.

# --- API ---
API_PORT=4000
# Comma-separated. `*` matches one subdomain label, for preview deploys: https://finvantage-web-*.vercel.app
WEB_ORIGIN=http://localhost:3000
DEMO_API_TOKEN=demo-token
# Email + password sign-in. AUTH_PRIVATE_JWK signs tokens (a private RSA JWK as JSON). Unset
# locally means a throwaway key, so sign-ins end when the API restarts. Required in production.
AUTH_PRIVATE_JWK=
# The token issuer, which must be the API's public URL. Defaults to https://finvantage-api.vercel.app
AUTH_ISSUER=

# --- Data ---
# Ledger (users, accounts, transactions, goals): memory | spacetime (uses the SPACETIME_* values below).
LEDGER_BACKEND=memory
# Documents (runs, Copilot events, life events, reports): memory | mongodb.
DOCUMENT_BACKEND=memory
MONGODB_URI=
MONGODB_DB=finvantage

# --- Bank data: Plaid when PLAID_CLIENT_ID and PLAID_SECRET are set, otherwise synthetic ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32 random bytes, base64. Encrypts stored Plaid access tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_KEY=

# --- LLM: mock (stub) | gemini. Confirm model names at the Google Cloud table. ---
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=

# --- Quarterly reports: local PDF output, Gmail SMTP, and scheduler ---
REPORT_OUTPUT_DIR=./data/reports
REPORT_EMAIL_OVERRIDE=
MAIL_PROVIDER=mock
# Keep the Resend variables only if using the legacy Resend adapter.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Secret used by the external cron request to /internal/reports/schedule/run.
SCHEDULER_SECRET=

# --- Live updates: sse (stub) | spacetime ---
LIVE_TRANSPORT=sse

# --- SpacetimeDB, for LEDGER_BACKEND=spacetime and live updates ---
# Defaults: https://maincloud.spacetimedb.com and finvantage. The token is an admin identity's:
# never commit it. Locally: `spacetime login show --token` (see apps/spacetime/README.md).
SPACETIME_URL=
SPACETIME_MODULE=
SPACETIME_TOKEN=

# --- Extension build (baked into the bundle, so never a secret) ---
EXTENSION_API_URL=http://localhost:4000
EXTENSION_WEB_URL=http://localhost:3000
EXTENSION_API_TOKEN=demo-token

# --- Web app (exposed to the browser, so never a secret) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_TOKEN=demo-token
# Live updates for signed-in users, e.g. wss://maincloud.spacetimedb.com. Unset means SSE only.
NEXT_PUBLIC_SPACETIME_URL=
NEXT_PUBLIC_SPACETIME_MODULE=finvantage
