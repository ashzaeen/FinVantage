# Copy to .env. Everything has a working default, so the stubs run with no .env at all.
# Server-side keys stay here. The web app and extension never hold model or bank keys.

# --- API ---
API_PORT=4000
# Comma-separated. `*` matches one subdomain label, for preview deploys: https://finvantage-web-*.vercel.app
WEB_ORIGIN=http://localhost:3000
DEMO_API_TOKEN=demo-token

# --- Data: memory (stub) | real (Tiger Data + Atlas) ---
DATA_BACKEND=memory
# These independent switches override DATA_BACKEND, so MongoDB can be used with the memory ledger.
LEDGER_BACKEND=memory
DOCUMENT_BACKEND=memory
TIGER_DATABASE_URL=
MONGODB_URI=
MONGODB_DB=finvantage

# --- Bank data: synthetic demo ---
BANK_PROVIDER=synthetic

# --- LLM: mock (stub) | gemini. Confirm model names at the Google Cloud table. ---
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=

# --- Quarterly reports: local PDF output, Gmail SMTP, and scheduler ---
REPORT_OUTPUT_DIR=./data/reports
REPORT_EMAIL_OVERRIDE=
MAIL_PROVIDER=mock
# Keep the Resend variables only if using the legacy Resend adapter.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Secret used by the external cron request to /internal/reports/schedule/run.
SCHEDULER_SECRET=

# --- Live updates: sse (stub) | spacetime ---
LIVE_TRANSPORT=sse
SPACETIME_URL=
SPACETIME_MODULE=

# --- Extension build (baked into the bundle, so never a secret) ---
EXTENSION_API_URL=http://localhost:4000
EXTENSION_WEB_URL=http://localhost:3000
EXTENSION_API_TOKEN=demo-token

# --- Web app (exposed to the browser, so never a secret) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_TOKEN=demo-token
