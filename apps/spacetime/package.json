{
  "name": "@finvantage/spacetime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "publish:maincloud": "spacetime publish finvantage --server maincloud -p . --yes",
