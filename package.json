{
  "name": "finvantage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web,ext -c blue,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ext\"",
    "dev:api": "npm run dev -w @finvantage/api",
    "dev:web": "npm run dev -w @finvantage/web",
    "dev:ext": "npm run dev -w @finvantage/extension",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "eval:advisor": "npm run eval:advisor -w @finvantage/api --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
